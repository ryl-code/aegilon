<!--
  - AEGILON Process Detection Pack
  - Focus: Process-related detections based on Osquery running_processes telemetry
  - Version: 1.1
  - Rules ID: 110001 - 110025
  - Verified fields used: osquery.name, osquery.action, osquery.columns.name, osquery.columns.path
-->

<group name="osquery,aegilon_process,">

  <!--
    Rule ID: 110001
    Purpose: Mendeteksi eksekusi PowerShell dari path standar sistem.
    MITRE Technique: T1059.001
    Expected Detection: Eksekusi powershell.exe dari C:\Windows\System32\...
  -->
  <rule id="110001" level="5">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^running_processes$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.name" type="pcre2">(?i)^powershell\.exe$</field>
    <field name="osquery.columns.path" type="pcre2">(?i)^[a-zA-Z]:\\Windows\\(System32|SysWOW64)\\WindowsPowerShell\\v1\.0\\powershell\.exe$</field>
    <description>AEGILON - PowerShell Execution</description>
    <group>script_execution,execution,powershell,</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

