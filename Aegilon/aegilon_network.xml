    </mitre>
  </rule>

  <!--
    Rule ID: 120012
    Purpose: Mendeteksi aktivitas transfer data menggunakan scp.exe/winscp.exe.
    MITRE Technique: T1048
    Expected Detection: Koneksi keluar dibuat oleh scp.exe atau winscp.exe
  -->
  <rule id="120012" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.path" type="pcre2">(?i)(scp|winscp)\.exe$</field>
    <description>AEGILON - Outbound SCP Connection</description>
    <group>network_connection,exfiltration,scp,</group>
    <mitre>
      <id>T1048</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120013
    Purpose: Mendeteksi shell (cmd/powershell) membuat koneksi TCP keluar yang tidak biasa.
    MITRE Technique: T1043
    Expected Detection: Koneksi TCP keluar oleh cmd.exe atau powershell.exe
  -->
  <rule id="120013" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.path" type="pcre2">(?i)(powershell|cmd)\.exe$</field>
    <description>AEGILON - Suspicious External Connection</description>
    <group>network_connection,c2,</group>
    <mitre>
      <id>T1043</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120014
    Purpose: Mendeteksi koneksi keluar menuju IP publik (non-RFC 1918) yang berpotensi menjadi C2 server.
    MITRE Technique: T1043
    Expected Detection: Koneksi ke alamat IP publik
  -->
  <rule id="120014" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.remote_address" type="pcre2">^(127\.0\.0\.1|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|0\.0\.0\.0|::1)$</field>
    <description>AEGILON - Rare Destination IP</description>
    <group>network_connection,c2,rare_destination,</group>
    <mitre>
      <id>T1043</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120031 (Base Rule)
    Purpose: Base rule for outbound network connections to public IPs.
  -->
  <rule id="120031" level="0">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.remote_address" type="pcre2">^(127\.0\.0\.1|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|0\.0\.0\.0|::1)$</field>
    <description>AEGILON - Outbound Network Connection to Public IP Base Event</description>
    <group>network_connection,c2,</group>
  </rule>

  <!--
    Rule ID: 120015
    Purpose: Mendeteksi indikasi beaconing (koneksi periodik berulang-ulang ke IP publik).
    MITRE Technique: T1071
    Expected Detection: Koneksi berulang-ulang ke IP publik dalam waktu singkat (30 koneksi / 120 detik)
  -->
  <rule id="120015" level="13" frequency="30" timeframe="120">
    <if_matched_sid>120031</if_matched_sid>
    <description>AEGILON - Beaconing Activity</description>
    <group>network_connection,c2,beaconing,</group>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

