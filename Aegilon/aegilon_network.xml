  </rule>

  <!--
    Rule ID: 120010
    Purpose: Mendeteksi koneksi keluar menggunakan protokol FTP untuk transfer data (exfiltration).
    MITRE Technique: T1048
    Expected Detection: Koneksi ke remote port 21
  -->
  <rule id="120010" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.remote_port">^21$</field>
    <description>AEGILON - Outbound FTP Connection</description>
    <group>network_connection,exfiltration,ftp,</group>
    <mitre>
      <id>T1048</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120011
    Purpose: Mendeteksi aktivitas transfer data menggunakan curl.exe.
    MITRE Technique: T1048
    Expected Detection: Koneksi keluar dibuat oleh curl.exe
  -->
  <rule id="120011" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
