<!--
  - AEGILON Network Detection Pack
  - Focus: Network-related detections based on Osquery network_connections and listening_ports telemetry
  - Version: 1.2
  - Rules ID: 120001 - 120020 (plus base SIDs 120030 - 120032)
-->

<group name="osquery,aegilon_network,">

  <!--
    Rule ID: 120001
    Purpose: Mendeteksi koneksi reverse shell dari cmd/powershell/nc/bash ke port yang tidak lazim.
    MITRE Technique: T1059
    Expected Detection: Koneksi dari shell ke port reverse shell (4444, 5555, 6666, 1337, 31337)
  -->
  <rule id="120001" level="15">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.remote_port" type="pcre2">^(4444|5555|6666|1337|31337)$</field>
    <field name="osquery.columns.path" type="pcre2">(?i)(cmd\.exe|powershell\.exe|nc\.exe|bash\.exe)$</field>
    <description>AEGILON - Reverse Shell Connection</description>
    <group>network_connection,reverse_shell,</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120002
    Purpose: Mendeteksi service yang membuka listening port 4444 (sering digunakan Metasploit/Netcat).
    MITRE Technique: T1571
    Expected Detection: Port 4444 berstatus LISTENING
  -->
  <rule id="120002" level="13">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^listening_ports$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.port">^4444$</field>
    <description>AEGILON - Listening Port 4444</description>
    <group>listening_port,reverse_shell,</group>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120003
    Purpose: Mendeteksi service yang membuka listening port 5555.
    MITRE Technique: T1571
    Expected Detection: Port 5555 berstatus LISTENING
  -->
  <rule id="120003" level="13">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^listening_ports$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.port">^5555$</field>
    <description>AEGILON - Listening Port 5555</description>
    <group>listening_port,reverse_shell,</group>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120004
    Purpose: Mendeteksi service yang membuka listening port 1337 (sering digunakan exploit).
    MITRE Technique: T1571
    Expected Detection: Port 1337 berstatus LISTENING
  -->
  <rule id="120004" level="13">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^listening_ports$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.port">^1337$</field>
    <description>AEGILON - Listening Port 1337</description>
    <group>listening_port,reverse_shell,</group>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120005
    Purpose: Mendeteksi service yang membuka listening port 31337 (BackOrifice/exploit).
    MITRE Technique: T1571
    Expected Detection: Port 31337 berstatus LISTENING
  -->
  <rule id="120005" level="13">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^listening_ports$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.port">^31337$</field>
    <description>AEGILON - Listening Port 31337</description>
    <group>listening_port,reverse_shell,</group>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120006
    Purpose: Mendeteksi service yang membuka listening port 9001 (sering digunakan web shell/reverse shell).
    MITRE Technique: T1571
    Expected Detection: Port 9001 berstatus LISTENING
  -->
  <rule id="120006" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^listening_ports$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.port">^9001$</field>
    <description>AEGILON - Listening Port 9001</description>
    <group>listening_port,reverse_shell,</group>
