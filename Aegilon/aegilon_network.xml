    </mitre>
  </rule>

  <!--
    Rule ID: 120018
    Purpose: Mendeteksi penyalahgunaan SMB (port 445) untuk lateral movement/remote access.
    MITRE Technique: T1021.002
    Expected Detection: Koneksi ke port remote 445
  -->
  <rule id="120018" level="10">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
