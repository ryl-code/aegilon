  <!--
    Rule ID: 120020
    Purpose: Mendeteksi jumlah koneksi konkuren yang sangat tinggi (indikasi DDOS/Recon/Anomali).
    MITRE Technique: T1095
    Expected Detection: Terlalu banyak koneksi dalam waktu singkat (50 koneksi / 60 detik)
  -->
  <rule id="120020" level="10" frequency="50" timeframe="60">
    <if_matched_sid>120030</if_matched_sid>
    <description>AEGILON - Multiple Concurrent Connections</description>
    <group>network_connection,anomaly,</group>
    <mitre>
      <id>T1095</id>
    </mitre>
  </rule>

</group>
