      <id>T1571</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120030 (Base Rule)
    Purpose: Base rule to match Osquery differential network connection creations.
  -->
  <rule id="120030" level="0">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <description>AEGILON - Network Connection Base Event</description>
    <group>network_connection,</group>
  </rule>

  <!--
    Rule ID: 120007
    Purpose: Mendeteksi aktivitas scanning port/network berdasarkan frekuensi koneksi yang tinggi.
    MITRE Technique: T1046
    Expected Detection: Terlalu banyak koneksi dalam waktu singkat (20 koneksi / 60 detik)
  -->
  <rule id="120007" level="10" frequency="20" timeframe="60">
    <if_matched_sid>120030</if_matched_sid>
    <description>AEGILON - Port Scan Activity</description>
    <group>network_connection,reconnaissance,port_scan,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120008
    Purpose: Mendeteksi koneksi jaringan yang dibuat oleh tools Nmap.
    MITRE Technique: T1046
    Expected Detection: Eksekusi nmap.exe melakukan koneksi
  -->
  <rule id="120008" level="13">
    <if_sid>24010</if_sid>
    <field name="osquery.name">^network_connections$</field>
    <field name="osquery.action">^added$</field>
    <field name="osquery.columns.path" type="pcre2">(?i)nmap\.exe$</field>
    <description>AEGILON - Nmap Network Activity</description>
    <group>network_connection,reconnaissance,nmap,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!--
    Rule ID: 120009
    Purpose: Mendeteksi koneksi jaringan yang dibuat oleh tools Masscan.
    MITRE Technique: T1046
