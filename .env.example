# ==========================================
# AEGILON XDR - Consolidated Environment Template
# Location: Root Repository (./.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==========================================

# --- Database Connection (Supabase PostgreSQL / Local Postgres) ---
DATABASE_URL=postgresql://postgres.your_user:your_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- Security / Authentication ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_SEED_EMAIL=admin@aegilon.com
ADMIN_SEED_PASSWORD=change-this-password-in-production
PYTHONUNBUFFERED=1

# --- Wazuh Manager API Integration ---
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=your_wazuh_password
WAZUH_API_VERIFY_SSL=false

# --- App & Service URL Configurations ---
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=/backend-proxy
NEXT_PUBLIC_AUTH_BYPASS=true

# --- Telegram Bot & Automation Integration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_group_id
N8N_WEBHOOK_URL=http://n8n:5678/webhook/telegram-notify
