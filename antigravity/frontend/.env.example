NEXT_PUBLIC_API_URL=http://localhost:8080

# Alternative for local dev when the frontend isn't running on the backend's
# allowed CORS origin (e.g. localhost:3000 is occupied by another project):
# point at the Next.js same-origin proxy instead (see next.config.ts rewrites).
# NEXT_PUBLIC_API_URL=/backend-proxy
# BACKEND_PROXY_TARGET=http://localhost:8080
